# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env at the repository root and fill in your values.
# Never commit a real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend ─────────────────────────────────────────────────────────────────
# URL the browser uses to reach the backend (only needed for production builds)
BACKEND_URL=http://localhost:5001

# ── Backend ──────────────────────────────────────────────────────────────────
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./data/db.sqlite3
AI_ENGINE_URL=http://localhost:5002
CORS_ORIGINS=http://localhost:3000

# ── AI Engine ────────────────────────────────────────────────────────────────
# Provide whichever LLM provider you use
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=text-embedding-3-small
